{
  "name": "dsh-gufa-code",
  "version": "1.0.2",
  "description": "古法编程 · AI 辅助：在 DSH Web 界面一键进入 VS Code 风格 IDE（Monaco 编辑器、文件树、Git、SSH、真实终端与右侧 AI 聊天）",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "ide",
    "vscode",
    "monaco",
    "cursor",
    "ai",
    "terminal",
    "git"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "vendor",
    "src",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "screenshots.json"
  ],
  "dependencies": {
    "ws": "^8.22.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "Jeff nan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liujiangnanchenjbguo/dsh-gufa-code.git"
  },
  "homepage": "https://github.com/liujiangnanchenjbguo/dsh-gufa-code#readme",
  "bugs": {
    "url": "https://github.com/liujiangnanchenjbguo/dsh-gufa-code/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
