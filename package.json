{
  "name": "dsh-gufa-code",
  "version": "1.3.198",
  "description": "古法编程 · AI 辅助：一键把 DSH 主面板变成 VS Code 风格 IDE（Monaco 编辑器、文件树、Git、SSH、真实终端 + 右侧官方会话）；主张亲手写、每个改动心中有数，AI 是助理、你是第一责任人",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "ide",
    "vscode",
    "monaco",
    "cursor",
    "ai",
    "terminal",
    "git"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "vendor",
    "src",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "screenshots.json",
    "desktop"
  ],
  "dependencies": {
    "eslint": "^8.57.1",
    "pyright": "^1.1.414",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "Jeff nan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liujiangnanchenjbguo/dsh-gufa-code.git"
  },
  "homepage": "https://github.com/liujiangnanchenjbguo/dsh-gufa-code#readme",
  "bugs": {
    "url": "https://github.com/liujiangnanchenjbguo/dsh-gufa-code/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/selftest-client.mjs && node scripts/selftest-host.mjs && node scripts/test-editor.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:float:macos": "./scripts/build-float-macos.sh",
    "build:float:linux": "./scripts/build-float-linux.sh"
  }
}
